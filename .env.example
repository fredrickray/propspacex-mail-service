# RabbitMQ
# Use localhost for local dev, rabbitmq for Docker
RABBIT_URL=amqp://guest:guest@localhost:5672
EMAIL_QUEUE=email_jobs
EMAIL_DLX=email_jobs_dlx
EMAIL_RETRY_ATTEMPTS=5

# Mail provider (example: SMTP or SendGrid SMTP)
SMTP_SERVICE=Gmail
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SECURE=true


# Service
PORT=9092
GRPC_PORT=50056
ENV=development

COMPANY_NAME=PropSpaceX